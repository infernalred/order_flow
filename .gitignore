/coverage/
coverage.*
*.coverprofile
*.prof
*.pprof

# Local Go workspace and vendored dependencies
go.work
go.work.sum
/vendor/

# Runtime data and logs
*.log
*.pid
/data/

# Environment and local configuration
.env
.env.*
!.env.example
*.local

