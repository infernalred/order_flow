*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
*~
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db

# Tool caches
.cache/
.task/
.golangci-lint-cache/

# Terraform state, if infrastructure is added later
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Local observability data
/deployments/observability/data/

